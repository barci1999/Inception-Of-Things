Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu-jammy"
  config.vm.box_url = "https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64-vagrant.box"

  # Desactivar la sustitución automática de la clave SSH para evitar el fallo de clave privada

  config.vm.define "smarquezS" do |server|
    server.vm.hostname = "smarquezS"
    server.vm.network "private_network", ip: "192.168.56.110"
    server.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
    end
    server.vm.provision "shell", path: "scripts/server.sh"
  end

  config.vm.define "smarquezSW" do |control|
    control.vm.hostname = "smarquezSW"
    control.vm.network "private_network", ip: "192.168.56.111"
    control.vm.provider "virtualbox" do |v|
      v.memory = 1024
      v.cpus = 1
    end
    control.vm.provision "shell", path: "scripts/worker.sh"
  end
end